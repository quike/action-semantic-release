{
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "custom"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "custom"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "[ -z \"$EXPECTED_VERSION\" ] || [ \"${nextRelease.version}\" = \"$EXPECTED_VERSION\" ]",
        "prepareCmd": "bash .github/scripts/set-action-image.sh ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "action.yml"
        ],
        "message": "ci(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ],
  "debug": true,
  "ci": false
}
