{
  "branches": [
    "main"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "custom"
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "verifyReleaseCmd": "[ -z \"$EXPECTED_VERSION\" ] || [ \"${nextRelease.version}\" = \"$EXPECTED_VERSION\" ]",
        "prepareCmd": "sed -i \"s|^  image: .*|  image: 'docker://ghcr.io/quike/action-semantic-release:${nextRelease.version}'|\" action.yml && grep -qxF \"  image: 'docker://ghcr.io/quike/action-semantic-release:${nextRelease.version}'\" action.yml"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "action.yml"
        ],
        "message": "ci(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github"
  ],
  "debug": true,
  "ci": false
}
